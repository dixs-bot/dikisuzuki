# Supabase project configuration (isi dengan nilai dari Supabase Dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Sales profile (gunakan nomor kontak resmi yang sudah dikonfirmasi)
NEXT_PUBLIC_SALES_NAME="Diki Wahyudin"
NEXT_PUBLIC_SALES_PHONE=""
NEXT_PUBLIC_SALES_WHATSAPP=""
NEXT_PUBLIC_DEALER_NAME="Suzuki Dealer"
NEXT_PUBLIC_DEALER_CITY=""

# SEO: ganti dengan domain HTTPS produksi yang benar, tanpa slash di akhir
NEXT_PUBLIC_SITE_URL=https://salesuzukibandung.site

# Opsional: token verifikasi Google Search Console (HTML tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
